#!/bin/bash
# Muestra subcadenas y asignación de valores por defecto

NOMBRE="Navarrux Live edition"
echo "${NOMBRE} -> una parte: ${NOMBRE:8} y otra: ${NOMBRE:8:4}"

# Valores por defecto (${variable:-valorpordefecto})
SINVALOR=
echo "Variable SINVALOR: ${SINVALOR:-31337} y ${VACIO:-'Miguel Indurain'}"
echo "La variable SINVALOR sigue sin valor: '${SINVALOR}'"

# Asignar valor por defecto si está vacía (${variable:=valorpordefecto})
echo "Estableciendo valor..."
echo "Variable SINVALOR: ${SINVALOR:=31337} y ${VACIO:='Miguel Indurain'}"
echo "Ahora la variable SINVALOR tiene valor: ${SINVALOR}"

# Reemplazar si SÍ tiene valor (${variable:+valorpordefecto})
PROGRAMA='sniffit'
echo "Valor alternativo de PROGRAMA: ${PROGRAMA:+'tcpdump'} y el real sigue siendo: ${PROGRAMA}"

# Listar variables por prefijo (${!prefijo*})
echo "Variables que empiezan con P:"
for i in ${!P*}; do 
    echo "$i"
done

