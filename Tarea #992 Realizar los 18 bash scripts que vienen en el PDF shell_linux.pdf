#!/bin/bash
# Atrapando señales del sistema (Ctrl+C, Ctrl+Z, etc.)

funcion () {
    echo -e "\n¡Se ha recibido una señal! Ejecutando handler..."
}

# Atrapa INT (Ctrl+C), QUIT (Ctrl+\) y TSTP (Ctrl+Z)
trap "funcion" INT QUIT TSTP

echo "Bucle infinito iniciado. Presiona Ctrl+C o Ctrl+Z para probar el trap."
echo "Para matar este script usa 'kill -9 $$' desde otra terminal."

while true; do
    sleep 2
    echo "ufff qué sueño..."
done

