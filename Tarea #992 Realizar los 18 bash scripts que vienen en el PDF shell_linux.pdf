#!/bin/bash
# Operaciones lógicas y comparaciones

booleano=true

# Si booleano es true se muestra OK
$booleano && echo "OK" || echo "no es true"

otrobool=false
test ${otrobool} || echo "Ahora es falso"

# Comparaciones numéricas (-eq, -ne, -lt, -le, -gt, -ge)
valor=6
test $valor -le 6 && echo "Se cumple que $valor <= 6"

nuevo=${valor}
test ${nuevo} -eq ${valor} && echo "Son lo mismo (${nuevo} == ${valor})"

