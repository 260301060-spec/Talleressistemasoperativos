#!/bin/bash
# Script para comprobar si un fichero existe. Espera un parámetro.
# Ejemplo de uso: ./script9.sh mi_archivo.txt

if [ -e "$1" ] && [ -f "$1" ]; then
    echo "OK, el fichero $1 existe"
else 
    echo "NO existe el fichero $1"
fi

# Comprobación mediante negación (!)
if [ ! -e "$1" ]; then
    echo "El archivo $1 definitivamente no existe"
fi

