#!/bin/bash
# Estructura select para menús de opción múltiple

echo "Select de distros"
DISTROS="Debian Ubuntu Navarrux Gentoo Mandriva"

echo "Selecciona la mejor opción por favor:"
select resultado in ${DISTROS}; do
    # Si la longitud de la cadena seleccionada es mayor a 0, sale del bucle
    if [ ${#resultado} -ne 0 ]; then
        break
    fi
    echo "Opción no válida. Selecciona otra opción:"
done

echo "Sistema seleccionado: [${resultado}] (Longitud de cadena: ${#resultado})"

