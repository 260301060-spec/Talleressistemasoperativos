#!/bin/bash
# Operaciones matemáticas con expr y []

VALOR1=23
VALOR2=45

RESULTADO=`expr ${VALOR1} + ${VALOR2}`
echo "Resultado con expr: ${RESULTADO}"

RESULTADO=`expr ${VALOR1} + ${VALOR2} + 3`
echo "Resultado acumulado: ${RESULTADO}"

VALOR1=5
VALOR2=4
echo "Valores: ${VALOR1} y ${VALOR2}"

RESULTADO=$[${VALOR1} + ${VALOR2} + 2]
echo "Ahora: ${VALOR1} + ${VALOR2} + 2 = ${RESULTADO}"

RESULTADO=$[${VALOR1} + $[${VALOR2} * 3]]
echo "Ahora: ${VALOR1} + (${VALOR2} * 3) = ${RESULTADO}"

