#!/bin/bash
# Definición y llamada de funciones

RESULTADO=0

# Función que muestra parámetros
muestrapantalla () {
    echo "Valores pasados: \$0=$0 | \$1=$1 | \$2=$2 | \$3=$3"
}

# Función que realiza una suma
sumame () {
    echo "Estamos en la función: ${FUNCNAME}"
    echo "Parámetros recibidos: $1 y $2"
    RESULTADO=`expr $1 + $2`
    return 0
}

# Llamada a función simple
muestrapantalla 3 4 "epa"

# Llamada a función con validación de retorno
sumame 45 67 && echo "Suma realizada con éxito" || echo "Ocurrió un error"
echo "Resultado global: ${RESULTADO}"

