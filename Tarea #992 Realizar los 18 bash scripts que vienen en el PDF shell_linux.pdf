#!/bin/bash
# Diferentes formas del bucle for

echo "FOR simple:"
for i in a b c d e f g h i; do
    echo "letra: $i"
done

NOMBRES="Iñigo Sten Asier Pello Roberto"
echo -e "\nFOR para recorrer una lista/array:"
echo "Participantes en la 4party:"
for i in ${NOMBRES}; do
    echo ${i}
done

echo -e "\nFOR con ficheros .sh:"
for i in *.sh; do
    ls -lh ${i} 2>/dev/null || echo "No hay archivos .sh aquí"
done

echo -e "\nFOR clásico estilo C:"
for ((cont=0; cont < 10; cont++)); do
    echo "Ahora valgo: ${cont}"
done


