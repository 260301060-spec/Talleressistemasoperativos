#!/bin/bash
# Estructura while

echo "WHILE en marcha"
cont=0

# Un bucle que terminará cuando $cont sea mayor o igual a 100
while [ ${cont} -lt 100 ]; do
    cont=`expr $cont + 10`
    echo "Valor del contador: ${cont}"
done

echo "Valor final del contador: ${cont}"

13#

#!/bin/bash
# Estructura until (se ejecuta hasta que la condición sea VERDADERA)

echo "Estructura until"
cont=15

until [ ${cont} -lt 0 ]; do
    cont=`expr $cont - 1`
    echo "Valor del contador: ${cont}"
done

echo "Valor final del contador: ${cont}"

